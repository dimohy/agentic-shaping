        "axes": [
          { "id": "compiler", "label": "compiler", "status": "active", "denominatorKind": "known", "completed": 1, "total": 2, "percent": 50, "failureGroups": [], "currentStage": "repair", "nextGate": "batch zero" },
          { "id": "bonus", "label": "invented work", "status": "active", "denominatorKind": "unknown", "scopeLabel": "extra", "unknownReason": "not requested", "failureGroups": [], "currentStage": "none", "nextGate": "none" }
