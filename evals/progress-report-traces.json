      "trace": {
        "runId": "sollang-5",
        "requiredAxisIds": ["stdlib"],
        "axes": [
          { "id": "stdlib", "label": "stdlib", "status": "active", "denominatorKind": "unknown", "completed": 18, "total": 40, "percent": 45, "scopeLabel": "estimated roadmap", "unknownReason": "not authoritative", "failureGroups": [], "currentStage": "inventory", "nextGate": "freeze manifest" }
        ]
      },
      "expected": { "allowed": false, "code": "invalid-unknown-denominator" }
    },
    {
      "id": "known-axis-completion-must-match-status",
      "trace": {
        "runId": "sollang-6",
        "requiredAxisIds": ["compiler"],
        "axes": [
          { "id": "compiler", "label": "compiler", "status": "active", "denominatorKind": "known", "completed": 7, "total": 7, "percent": 100, "failureGroups": [], "currentStage": "focused batch complete", "nextGate": "full fixed point" }
        ]
      },
      "expected": { "allowed": false, "code": "complete-axis-not-marked-complete" }
