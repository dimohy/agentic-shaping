{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shaping.dev/schemas/skill-abstraction-trace.schema.json",
  "title": "AS-SA-001 skill abstraction and candidate submission trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["ruleId", "traceAuthority", "signal", "classification", "evaluationPayload", "forbiddenActions"],
  "properties": {
    "ruleId": { "const": "AS-SA-001" },
    "traceAuthority": { "const": "orchestrator" },
    "signal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "durable", "machineDecidable", "sourceSignals"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "durable": { "const": true },
        "machineDecidable": { "const": true },
        "sourceSignals": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "locator"],
            "properties": {
              "kind": { "enum": ["correction", "repeated-failure", "manual-judgment", "successful-pattern"] },
              "locator": { "type": "string", "pattern": "^(artifact|file)://[^\\s]+$|^https://[^\\s]+$|^urn:[^\\s]+$" }
            }
          }
        }
      }
    },
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "independentDomains", "evidence"],
      "properties": {
        "level": { "enum": ["local", "project", "cross-project", "general-method"] },
        "independentDomains": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    },
    "privacy": { "$ref": "skill-lifecycle-trace.schema.json#/$defs/privacy" },
    "synthesis": {
      "type": "object", "additionalProperties": false,
      "required": ["generatedBy", "slug", "version", "description", "skillMarkdown", "license", "sourceLicense", "visibility", "provenance", "verifiedPlatforms", "supportingFilesJson", "preparedContentHash", "packageIdentity", "structuredAssetPlan", "evaluationContract", "projectIdentifiersRemaining", "personalReferencesRemaining", "privacyScanSha256", "prepareEvidence"],
      "properties": {
        "generatedBy": { "const": "agentic-shaping-skill-synthesizer" },
        "slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "description": { "type": "string", "minLength": 10, "maxLength": 500 },
        "skillMarkdown": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+$" },
        "sourceLicense": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+$" },
        "visibility": { "const": "registry-candidate" },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["sourceType", "sourceLocator", "sourceSha256", "licenseVerified", "licenseEvidenceLocator", "licenseEvidenceSha256"],
          "properties": {
            "sourceType": { "enum": ["original", "adapted"] },
            "sourceLocator": { "type": "string", "minLength": 1 },
            "sourceSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
            "licenseVerified": { "const": true },
            "licenseEvidenceLocator": { "type": "string", "minLength": 1 },
            "licenseEvidenceSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
          }
        },
        "verifiedPlatforms": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["platform", "suiteId", "evidenceLocator", "evidenceSha256"],
            "properties": {
              "platform": { "enum": ["windows", "linux", "macos"] },
              "suiteId": { "type": "string", "minLength": 1 },
              "evidenceLocator": { "type": "string", "minLength": 1 },
              "evidenceSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
            }
          }
        },
        "supportingFilesJson": { "type": ["string", "null"] },
        "preparedContentHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "packageIdentity": { "type": "string", "minLength": 1 },
        "structuredAssetPlan": { "type": "string", "minLength": 1 },
        "evaluationContract": { "type": "string", "minLength": 1 },
        "projectIdentifiersRemaining": { "const": 0 },
        "personalReferencesRemaining": { "const": 0 },
        "privacyScanSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "prepareEvidence": { "$ref": "#/$defs/evidenceList" }
      }
    },
    "evaluation": { "$ref": "skill-lifecycle-trace.schema.json#/$defs/evaluation" },
    "evaluationPayload": { "type": "object", "minProperties": 1 },
    "forbiddenActions": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "evidenceList": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
