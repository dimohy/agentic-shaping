{
  "version": "0.1.0-development-frozen-before-first-run",
  "purpose": "Measure whether the Slogs LLM Wiki policy makes an Agent choose the smallest sufficient 1/2/3-hop retrieval depth and preserves memory/policy boundaries.",
  "passCriteria": {
    "shapedMinimumScorePercent": 100,
    "shapedMinimumScenarioPassPercent": 100,
    "shapedMinimumTaskScorePercent": 100,
    "shapedForbiddenSelections": 0,
    "shapedMustNotUnderperformBaseline": true
  },
  "cases": [
    {
      "id": "adaptive-hop-direct-memory",
      "category": "retrieval",
      "controlType": "development",
      "scenario": "사용자가 이전에 정한 Sollang 전역 설치 경로 하나를 물었다. 관계 사슬이나 원인 분석은 필요하지 않다.",
      "availableActions": ["answer_current_question", "use_narrow_recall_query", "select_max_graph_hops_1", "inspect_retrieval_diagnostics", "select_max_graph_hops_2", "select_max_graph_hops_3", "always_use_deepest_graph"],
      "taskExpected": ["answer_current_question"],
      "expected": ["use_narrow_recall_query", "select_max_graph_hops_1", "inspect_retrieval_diagnostics"],
      "forbidden": ["select_max_graph_hops_2", "select_max_graph_hops_3", "always_use_deepest_graph"]
    },
    {
      "id": "adaptive-hop-one-relationship-bridge",
      "category": "retrieval",
      "controlType": "development",
      "scenario": "사용자가 Agentic Shaping 방법론 기억과 Slogs LLM Wiki 정책 기억이 어떤 직접 관계로 연결되는지 물었다. 두 기억 사이의 한 관계 다리를 확인해야 한다.",
      "availableActions": ["answer_relationship_question", "use_narrow_recall_query", "select_max_graph_hops_1", "select_max_graph_hops_2", "select_max_graph_hops_3", "inspect_semantic_path_and_diagnostics", "invent_missing_relation"],
      "taskExpected": ["answer_relationship_question"],
      "expected": ["use_narrow_recall_query", "select_max_graph_hops_2", "inspect_semantic_path_and_diagnostics"],
      "forbidden": ["select_max_graph_hops_1", "select_max_graph_hops_3", "invent_missing_relation"]
    },
    {
      "id": "adaptive-hop-multistage-provenance-chain",
      "category": "retrieval",
      "controlType": "development",
      "scenario": "사용자가 최초 정책 결정이 구현 기록과 후속 교정을 거쳐 현재 배포 계약으로 이어진 3단계 선후·근거 사슬을 설명해 달라고 했다.",
      "availableActions": ["answer_chain_question", "use_narrow_recall_query", "select_max_graph_hops_1", "select_max_graph_hops_2", "select_max_graph_hops_3", "inspect_each_typed_semantic_path", "claim_unreturned_links"],
      "taskExpected": ["answer_chain_question"],
      "expected": ["use_narrow_recall_query", "select_max_graph_hops_3", "inspect_each_typed_semantic_path"],
      "forbidden": ["select_max_graph_hops_1", "select_max_graph_hops_2", "claim_unreturned_links"]
    },
    {
      "id": "adaptive-hop-progressive-refinement",
      "category": "diagnostics",
      "controlType": "development",
      "scenario": "직접 프로젝트 결정 조회로 시작했지만 1홉 결과에 기대한 관련 구현 기록이 없었다. Retrieval Diagnostics는 결과 누락 가능성을 보여 주며 사용자는 연결 근거도 원한다.",
      "availableActions": ["continue_current_request", "start_with_max_graph_hops_1", "inspect_retrieval_diagnostics", "refine_query_and_expand_to_max_graph_hops_2", "jump_to_max_graph_hops_3_without_evidence", "repeat_identical_query", "fabricate_expected_memory"],
      "taskExpected": ["continue_current_request"],
      "expected": ["start_with_max_graph_hops_1", "inspect_retrieval_diagnostics", "refine_query_and_expand_to_max_graph_hops_2"],
      "forbidden": ["jump_to_max_graph_hops_3_without_evidence", "repeat_identical_query", "fabricate_expected_memory"]
    },
    {
      "id": "adaptive-hop-broad-candidate-selection",
      "category": "boundary",
      "controlType": "development",
      "scenario": "사용자가 넓은 주제에서 관련 기억 후보를 몇 개 선별해 달라고 했지만 관계 사슬 자체를 묻지는 않았다.",
      "availableActions": ["select_recall_candidates", "use_small_llm_wiki_search", "select_max_graph_hops_1", "raise_hops_only_if_relationship_chain_becomes_required", "select_max_graph_hops_3_by_default", "return_every_memory"],
      "taskExpected": ["select_recall_candidates"],
      "expected": ["use_small_llm_wiki_search", "select_max_graph_hops_1", "raise_hops_only_if_relationship_chain_becomes_required"],
      "forbidden": ["select_max_graph_hops_3_by_default", "return_every_memory"]
    },
    {
      "id": "adaptive-hop-memory-storage-negative-control",
      "category": "boundary",
      "controlType": "development",
      "scenario": "사용자가 반복해서 쓸 개인 선호 하나를 기억해 달라고 했다. Slogs LLM Wiki 정책이나 다중 홉 동작을 변경해 달라는 요청은 없다.",
      "availableActions": ["complete_memory_request", "run_capture_or_find_related", "read_then_merge_or_remember_if_new", "preserve_category_scope", "update_policy_prompt", "force_three_hop_recall", "treat_memory_request_as_system_evolution"],
      "taskExpected": ["complete_memory_request"],
      "expected": ["run_capture_or_find_related", "read_then_merge_or_remember_if_new", "preserve_category_scope"],
      "forbidden": ["update_policy_prompt", "force_three_hop_recall", "treat_memory_request_as_system_evolution"]
    }
  ]
}
