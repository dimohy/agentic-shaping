{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shaping.slogs.dev/evals/expensive-gate-evidence.schema.json",
  "title": "Agentic Shaping Expensive Gate Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gateId",
    "gateOrdinal",
    "estimatedCostMs",
    "evidenceSource",
    "inputFingerprintBefore",
    "inputFingerprintAfter",
    "changedContracts",
    "declaredConsumers",
    "consumerAudits",
    "probes",
    "priorLateFailures",
    "outcomeObservability"
  ],
  "properties": {
    "gateId": { "type": "string", "minLength": 1 },
    "gateOrdinal": { "type": "integer", "minimum": 1 },
    "estimatedCostMs": { "type": "integer", "minimum": 0 },
    "evidenceSource": { "const": "harness-events" },
    "inputFingerprintBefore": { "$ref": "#/$defs/sha256" },
    "inputFingerprintAfter": { "$ref": "#/$defs/sha256" },
    "changedContracts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "declaredConsumers": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumer" }
    },
    "consumerAudits": {
      "type": "array",
      "items": { "$ref": "#/$defs/audit" }
    },
    "probes": {
      "type": "array",
      "items": { "$ref": "#/$defs/probe" }
    },
    "priorLateFailures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/lateFailure" }
    },
    "outcomeObservability": {
      "$ref": "#/$defs/outcomeObservability"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "consumerId"],
      "properties": {
        "contractId": { "type": "string", "minLength": 1 },
        "consumerId": { "type": "string", "minLength": 1 }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "consumerId", "outcome", "evidenceId"],
      "properties": {
        "contractId": { "type": "string", "minLength": 1 },
        "consumerId": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["pass", "fail"] },
        "evidenceId": { "type": "string", "minLength": 1 }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probeId", "kind", "outcome", "evidenceId"],
      "properties": {
        "probeId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["positive", "negative"] },
        "outcome": { "enum": ["pass", "fail"] },
        "evidenceId": { "type": "string", "minLength": 1 }
      }
    },
    "lateFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failureId", "discoveredGateOrdinal", "promotedGateOrdinal", "probeId", "evidenceId"],
      "properties": {
        "failureId": { "type": "string", "minLength": 1 },
        "discoveredGateOrdinal": { "type": "integer", "minimum": 1 },
        "promotedGateOrdinal": { "type": "integer", "minimum": 1 },
        "probeId": { "type": "string", "minLength": 1 },
        "evidenceId": { "type": "string", "minLength": 1 }
      }
    },
    "outcomeObservability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durableLogPath", "completionRecordPath", "recordSchemaVersion", "capturesExitCode", "capturesFailureIds", "executionMode", "survivesObserverDisconnect", "waitsOnSupervisedProcessOnly", "writesCompletionRecordOnTermination", "successRequiresEmptyFailureIds", "failureIdsRequireFailureContext"],
      "properties": {
        "durableLogPath": { "type": "string", "minLength": 1 },
        "completionRecordPath": { "type": "string", "minLength": 1 },
        "recordSchemaVersion": { "const": 1 },
        "capturesExitCode": { "type": "boolean" },
        "capturesFailureIds": { "type": "boolean" },
        "executionMode": { "const": "detached-supervisor" },
        "survivesObserverDisconnect": { "type": "boolean" },
        "waitsOnSupervisedProcessOnly": { "type": "boolean" },
        "writesCompletionRecordOnTermination": { "type": "boolean" },
        "successRequiresEmptyFailureIds": { "type": "boolean" },
        "failureIdsRequireFailureContext": { "type": "boolean" }
      }
    }
  }
}
