{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-shaping.dev/schemas/skill-lifecycle-trace.schema.json",
  "title": "AS-SK-001 skill lifecycle trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["ruleId", "traceAuthority", "phase", "candidate", "privacy", "forbiddenActions"],
  "properties": {
    "ruleId": { "const": "AS-SK-001" },
    "traceAuthority": { "const": "orchestrator" },
    "phase": { "enum": ["discovery", "promotion", "resolution"] },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "version", "contentHash", "reusableAcrossProjects", "generalized", "sourceSignals", "structuredAssetPlan", "evaluationContract"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "contentHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "reusableAcrossProjects": { "const": true },
        "generalized": { "const": true },
        "sourceSignals": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "locator"],
            "properties": {
              "kind": { "enum": ["correction", "repeated-failure", "manual-judgment", "successful-pattern"] },
              "locator": { "type": "string", "minLength": 1 }
            }
          }
        },
        "structuredAssetPlan": { "type": "string", "minLength": 1 },
        "evaluationContract": { "type": "string", "minLength": 1 }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["containsPersonalMemory", "containsProjectConfidential", "containsCredential", "containsSecret", "generalizationVerified", "evidence"],
      "properties": {
        "containsPersonalMemory": { "const": false },
        "containsProjectConfidential": { "const": false },
        "containsCredential": { "const": false },
        "containsSecret": { "const": false },
        "generalizationVerified": { "const": true },
        "evidence": { "$ref": "#/$defs/artifactEvidenceList" }
      }
    },
    "evaluation": { "$ref": "#/$defs/evaluation" },
    "publication": { "$ref": "#/$defs/publication" },
    "selection": { "$ref": "#/$defs/selection" },
    "resolution": { "$ref": "#/$defs/resolution" },
    "forbiddenActions": { "type": "array", "maxItems": 0 },
    "packageContentReleased": { "type": "boolean" }
  },
  "$defs": {
    "evidenceList": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "artifactEvidenceList": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["locator", "sha256"],
        "properties": {
          "locator": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        }
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["suiteId", "evaluatorVersion", "frozenBeforeRun", "caseResults", "passed", "total", "forbiddenActions", "artifactEvidence", "outputSha256"],
      "properties": {
        "suiteId": { "type": "string", "minLength": 1 },
        "evaluatorVersion": { "type": "string", "minLength": 1 },
        "frozenBeforeRun": { "const": true },
        "caseResults": {
          "type": "array", "minItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "passed", "total"],
            "properties": {
              "kind": { "enum": ["normal", "boundary", "negative-control"] },
              "passed": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "forbiddenActions": { "type": "integer", "const": 0 },
        "artifactEvidence": { "$ref": "#/$defs/artifactEvidenceList" },
        "outputSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["registry", "status", "slug", "version", "contentHash", "publishedBy", "validationReportHash"],
      "properties": {
        "registry": { "const": "slogs-skill-registry" },
        "status": { "const": "validated" },
        "slug": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "publishedBy": { "type": "string", "minLength": 1 },
        "validationReportHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["firstUseDecisionRequired", "choicePrompted", "scopeKind", "autoUpdate", "decisionEvidence"],
      "properties": {
        "firstUseDecisionRequired": { "type": "boolean" },
        "choicePrompted": { "type": "boolean" },
        "scopeKind": { "enum": ["project", "global", "disabled"] },
        "projectKey": { "type": "string", "minLength": 1 },
        "autoUpdate": { "type": "boolean" },
        "pinnedVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "decisionEvidence": { "$ref": "#/$defs/evidenceList" }
      }
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["registry", "status", "latestValidatedVersion", "resolvedVersion", "resolvedContentHash", "contentReleased", "registryEvidence"],
      "properties": {
        "registry": { "const": "slogs-skill-registry" },
        "status": { "const": "validated" },
        "latestValidatedVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "resolvedVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "resolvedContentHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "contentReleased": { "type": "boolean" },
        "registryEvidence": { "$ref": "#/$defs/evidenceList" }
      }
    }
  }
}
