    {
      "id": "evidence-before-every-poll",
      "expected": { "allowed": true, "code": "OK" },
      "events": [
        { "kind": "start", "runId": "build-1", "pendingSafeWork": 2, "nextActionId": "inventory" },
        { "kind": "evidence", "evidenceKind": "inventory", "actionId": "inventory", "nextActionId": "fixture-design", "conflictsActiveInputs": false, "competesHighLoad": false },
        { "kind": "evidence", "evidenceKind": "fixture-design", "actionId": "fixture-design", "nextActionId": "", "conflictsActiveInputs": false, "competesHighLoad": false },
        { "kind": "poll", "waitedMs": 1000 },
        { "kind": "finish" }
      ]
    },
    {
      "id": "first-poll-with-safe-work-is-blocked",
      "expected": { "allowed": false, "code": "AS-BI-001-IDLE-WAIT" },
      "events": [
        { "kind": "start", "runId": "build-2", "pendingSafeWork": 1, "nextActionId": "contract-review" },
        { "kind": "poll", "waitedMs": 1000 }
      ]
    },
    {
