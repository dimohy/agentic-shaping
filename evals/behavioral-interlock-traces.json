        { "kind": "start", "runId": "build-3", "pendingSafeWork": 0, "nextActionId": "" },
        { "kind": "queue-empty", "reason": "Every remaining action mutates the active compiler input snapshot." },
        { "kind": "poll", "waitedMs": 120000 },
        { "kind": "poll", "waitedMs": 180000 },
        { "kind": "finish" }
      ]
    },
